<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SignInMauiWorkforce.Pages.SignInPage"
             Title="Microsoft Entra ID">

    <ScrollView>
        <VerticalStackLayout
            Spacing="25"
            Padding="30,0"
            VerticalOptions="Center">

            <Image
                Source="azure_active_directory.png"
                SemanticProperties.Description="Microsoft Entra ID logo"
                HeightRequest="200"
                HorizontalOptions="Center" />

            <Label
                Text="Microsoft Entra ID"
                SemanticProperties.HeadingLevel="Level1"
                FontSize="26"
                HorizontalOptions="Center" />

            <Label
                Text="MAUI sample"
                SemanticProperties.HeadingLevel="Level2"
                FontSize="26"
                HorizontalOptions="Center" />

            <Button
                x:Name="SignInButton"
                Text="Sign In"
                SemanticProperties.Hint="Sign in with your work or school account"
                Clicked="OnSignInClicked"
                HorizontalOptions="Center"
                IsEnabled="False" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
